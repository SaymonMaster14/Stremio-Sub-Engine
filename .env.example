HOST=0.0.0.0
PORT=7000
BASE_URL=http://127.0.0.1:7000
CACHE_DIR=.cache
CACHE_TTL_SECONDS=86400
MAX_RESULTS=8
MIN_CONFIDENCE=0.55

# Required for OpenSubtitles search/download.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_TOKEN=
OPENSUBTITLES_USER_AGENT=StremioSubEngine v0.1.0

# none | libretranslate | ollama
TRANSLATOR=none
LIBRETRANSLATE_URL=http://127.0.0.1:5000
LIBRETRANSLATE_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
TRANSLATION_CONCURRENCY=4

# Full media-aware synchronization/ASR. Keep disabled on public Internet hosts unless you understand the SSRF implications.
ENABLE_MEDIA_ACCESS=false
ALLOW_PRIVATE_STREAMS=true
SYNC_ENGINE=ffsubsync
FFSUBSYNC_COMMAND=ffsubsync
ALASS_COMMAND=alass-cli
SYNC_TIMEOUT_MS=180000

ENABLE_ASR=false
PYTHON_COMMAND=python3
ASR_MODEL=small
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=auto
ASR_TIMEOUT_MS=900000
